# ============================================================
#  Plantilla de configuración del laboratorio AMQP MITM
#  Copia este archivo a `.env` y cambia las credenciales:
#      cp .env.example .env
#  El archivo `.env` está en .gitignore y NO debe subirse.
# ============================================================

# --- Credenciales de RabbitMQ ---
# Cámbialas. No reutilices credenciales de entornos reales.
RABBITMQ_USER=lab_user
RABBITMQ_PASS=cambia_esta_clave

# --- Conexión AMQP (usada por productor y consumidor) ---
AMQP_HOST=rabbit
AMQP_PORT=5672
AMQP_QUEUE=insane_queue

# --- Configuración del atacante (el_sniffer) ---
# Víctimas del ARP spoofing (nombres de servicio en la red docker).
# Interceptamos el camino de publicación: productor <-> broker.
MITM_TARGET_A=el_enviador
MITM_TARGET_B=rabbit
# Modo de interceptación: relay (portable, por defecto) | nfqueue (requiere kernel con nfnetlink_queue)
MITM_MODE=relay
